# Public browser config
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SITE_URL=http://localhost:5500

# Server-only Netlify Function config
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_PRICE_ID=price_your_subscription_price_id
STRIPE_SUCCESS_URL=http://localhost:5500/settings?billing=success
STRIPE_CANCEL_URL=http://localhost:5500/settings?billing=cancelled

# Optional for future Stripe webhooks or admin jobs. Never expose this in Vite.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
